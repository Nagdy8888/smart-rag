# Hosted-Supabase laptop ingest (Phase A). Names only. Copy to gitignored
# `.env.compose`. Never commit secrets. Do not use this file on EC2.
#
# Related: docs/runbooks/demo-local-ingest-aws-ask.md
# Do not set SMART_RAG_SUBPROCESSOR_MATRIX_VERIFIED=true.

APP_ENV=local
MOCK_MODEL_MODE=false
OPENAI_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-rag
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Hosted Auth JWKS origin. Required. Compose fails closed if unset.
SUPABASE_URL=

# LOGIN wrapper app_runtime. Never postgresql://postgres:
# API SQL may use the transaction pooler. Worker/checkpoint/LightRAG must be session.
API_SUPABASE_DB_URL=
WORKER_SUPABASE_DB_URL=
LANGGRAPH_CHECKPOINT_URL=
LIGHTRAG_DB_URL=
WORKER_GRAPH_ENABLED=false

# Browser-safe hosted Auth. Required at frontend image build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Operator one-shot to mark graph-200 eligible after promote (session URL).
# OPERATOR_SUPABASE_DB_URL=

# Frontend ask against laptop API (optional).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
