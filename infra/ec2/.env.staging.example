# Gitignored live copy: infra/ec2/.env.staging
# Never paste values into chat, git, Vercel beyond the three NEXT_PUBLIC_* keys,
# or the EC2 instance via a committed file.
# ParadeDB and Valkey do not use vendor API keys. Generate passwords locally.

APP_ENV=staging
# Hosted APP_ENV=staging rejects MOCK_MODEL_MODE=true. Use false plus OPENAI_API_KEY.
MOCK_MODEL_MODE=false
SMART_RAG_HOLDOUT_ACCESS=false
ACTIVE_API_UPSTREAM=api-blue:8000
CADDYFILE_PATH=./Caddyfile.http443
CORS_ALLOW_ORIGINS=https://smart-rag-staging-nagdy8888s-projects.vercel.app,https://smart-rag-staging.vercel.app

# Hosted Free project (public URL). Do not rewrite intended freeze Pro/us-east-1.
STAGING_SUPABASE_URL=https://qsjivtwtmlmtksufqjik.supabase.co

# From Supabase Dashboard → Project Settings → Database → Connection string.
# Transaction pooler (port 6543) for API/RPC. Session (port 5432) for worker/LangGraph.
STAGING_SUPABASE_TRANSACTION_URL=
STAGING_SUPABASE_SESSION_URL=

# Generate with Python secrets.token_urlsafe(32). Distinct values.
PARADEDB_DB=paradedb
PARADEDB_BOOTSTRAP_USER=paradedb
PARADEDB_BOOTSTRAP_PASSWORD=
PARADEDB_WRITER_USER=paradedb_writer
PARADEDB_WRITER_PASSWORD=
PARADEDB_READER_USER=paradedb_reader
PARADEDB_READER_PASSWORD=
VALKEY_LIMITS_PASSWORD=
VALKEY_CACHE_PASSWORD=

# Copy from gitignored terraform.tfvars. Pending may equal current until rotation.
ORIGIN_HEADER_NAME=
ORIGIN_HEADER_VALUE=
ORIGIN_HEADER_VALUE_PREVIOUS=
ORIGIN_HEADER_NAME_PENDING=
ORIGIN_HEADER_VALUE_PENDING=

# Optional until MOCK_MODEL_MODE=false
# OPENAI_API_KEY=
# LANGSMITH_API_KEY=

# ECR URLs so Compose pulls freeze digests from the account, not Docker Hub.
# STAGING_API_REPOSITORY=665602132723.dkr.ecr.us-east-1.amazonaws.com/smart-rag-api
# STAGING_WORKER_REPOSITORY=665602132723.dkr.ecr.us-east-1.amazonaws.com/smart-rag-worker
# STAGING_CRAWL_REPOSITORY=665602132723.dkr.ecr.us-east-1.amazonaws.com/smart-rag-crawl-proxy
# STAGING_PARSER_REPOSITORY=665602132723.dkr.ecr.us-east-1.amazonaws.com/smart-rag-parser-sandbox
