  "info": {
    "description": "Phase 1 foundation transport scaffold. Business routes are not implemented; readiness is unconfigured until later phases.",
    "title": "Smart RAG API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/glossary/imports": {
      "post": {
        "description": "Import a pending glossary batch. Members cannot seed aliases.\n\nArgs:\n    request: FastAPI request with backend settings.\n    body: Source, version, idempotency key, and entries.\n    caller: Authenticated caller context.\n\nReturns:\n    Import identifiers. Duplicate idempotency keys reuse one row.\n\nRaises:\n    HTTPException: 403 for members/viewers, 400 for validation failures,\n        503 when the database URL is unset.",
        "operationId": "create_glossary_import_admin_glossary_imports_post",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
