      "EnqueueWebsiteCrawlRequest": {
        "description": "Owner/admin request to crawl one approved start URL.",
        "properties": {
          "approved_domain": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Approved Domain",
            "type": "string"
          },
          "attestation_policy_version": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attestation Policy Version"
          },
          "content_class": {
            "default": "synthetic",
            "maxLength": 32,
            "title": "Content Class",
            "type": "string"
          },
          "document_title": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Title"
          },
          "graph_eligible": {
            "default": false,
            "title": "Graph Eligible",
            "type": "boolean"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "max_depth": {
            "default": 2,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Max Depth",
            "type": "integer"
          },
          "max_pages": {
            "default": 50,
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "type": "integer"
          },
          "start_url": {
            "maxLength": 2048,
            "minLength": 8,
            "title": "Start Url",
            "type": "string"
          }
        },
        "required": [
          "start_url",
          "approved_domain",
          "idempotency_key"
        ],
        "title": "EnqueueWebsiteCrawlRequest",
        "type": "object"
      },
