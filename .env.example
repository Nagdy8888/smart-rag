# Local development placeholders only. Copy to .env.compose (gitignored).
# No AWS required. Mock-model mode does not need a live OpenAI key.

APP_ENV=local
MOCK_MODEL_MODE=true
# ALLOW_TEST_IDENTITY=true is valid only with APP_ENV=test. Staging/production reject it.
# ALLOW_INPROCESS_PARSER=true is valid only with APP_ENV=test. Worker still refuses Storage Admin.
LOG_LEVEL=INFO
MOCK_MODEL_FIXTURE_ID=phase-1-foundation-v1
MODEL_INPUT_MAX_CHARS=16384
WORKER_ONCE=false

API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8000

# ParadeDB (private network only)
PARADEDB_DB=paradedb
PARADEDB_BOOTSTRAP_USER=paradedb
PARADEDB_BOOTSTRAP_PASSWORD=change-me-paradedb-bootstrap
PARADEDB_WRITER_USER=paradedb_writer
PARADEDB_WRITER_PASSWORD=change-me-paradedb-writer
PARADEDB_READER_USER=paradedb_reader
PARADEDB_READER_PASSWORD=change-me-paradedb-reader

# Valkey - distinct credentials and policies
VALKEY_LIMITS_PASSWORD=change-me-valkey-limits
VALKEY_CACHE_PASSWORD=change-me-valkey-cache

# Packet 8 host-proof overlay (loopback only; see docker-compose.packet8.yml)
# PARADEDB_URL=postgresql://paradedb_writer:change-me-paradedb-writer@127.0.0.1:54329/paradedb
# CRAWL_PROXY_URL=http://127.0.0.1:18080
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=13310
# SMART_RAG_REQUIRE_JOB_INTEGRATION=1
# SMART_RAG_REQUIRE_CLAMAV=1
# SMART_RAG_REQUIRE_CRAWL_PROXY=1
# SMART_RAG_HOLDOUT_ACCESS=false
# SMART_RAG_HOLDOUT_ACCESS_PURPOSE=
# SMART_RAG_HOLDOUT_ACCESS_ACTOR=
# SMART_RAG_OLD_API_IMAGE=sha256:<prior-expand-compatible-api-id-not-packet1-freeze>
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# WORKER_INSTANCE_ID=worker-local
# JOB_LEASE_SECONDS=300
# JOB_HEARTBEAT_INTERVAL_SECONDS=60
# JOB_POLL_INTERVAL_SECONDS=5
# WORKER_CONCURRENCY=2
# Session/direct only (local 54322, hosted session 5432). Never transaction
# pooler port 6543 or pgbouncer=true. Dedicated checkpoint DSN is required
# when SUPABASE_DB_URL is a transaction pooler.
# LANGGRAPH_CHECKPOINT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional graph attach. Same session/direct rule. Unset keeps LightRAG idle.
# LIGHTRAG_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Inbucket/Mailpit SMTP for durable admin alerts (Packet 8)
# ADMIN_ALERT_SMTP_HOST=127.0.0.1
# ADMIN_ALERT_SMTP_PORT=54325
# ADMIN_ALERT_SMTP_FROM=alerts@localhost
# ADMIN_ALERT_SMTP_TO=owner@localhost

# Local frontend origins for credentialed CORS (no wildcards)
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3010,http://localhost:3010
API_VERSION=0.1.0
SSE_SCHEMA_VERSION=1
MIN_CLIENT_VERSION=0.1.0
RETRIEVAL_CACHE_RESULT_TTL_SECONDS=30
RETRIEVAL_CACHE_PROFILE_TTL_SECONDS=300
REQUEST_MAX_BODY_BYTES=1048576
VALKEY_TIMEOUT_SECONDS=0.2
RATE_LIMIT_RETRY_AFTER_SECONDS=60

# Optional later (not required for mock foundation).
# Put live keys in gitignored `.env` and `.env.compose` (scripts prefer compose).
# MOCK_MODEL_MODE=false uses OPENAI_API_KEY; real company files stay prohibited
# until OPENAI_DATA_GOVERNANCE.org rows are verified. LangSmith tracing
# exports hashes/counts/usage only (hide I/O is forced at startup). Hosted
# LangGraph Studio UI still needs LANGSMITH_API_KEY even when tracing stays
# false. See docs/development/LANGGRAPH_STUDIO.md.
# OPENAI_API_KEY=replace-with-provider-key
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=smart-rag
# LANGSMITH_ENDPOINT=

# Runtime Compose requires hosted SUPABASE_URL in gitignored .env.compose.
# The loopback value below is the local destructive-test fixture origin only.
# Hosted laptop runtime: copy .env.hosted-ingest.example and run
# scripts/ops/wire_hosted_ingest_env.py. When APP_ENV=local and the origin is
# one of the two fixture hostnames, FastAPI accepts either iss; signature
# still uses SUPABASE_URL JWKS.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_SECONDS=600
# SUPABASE_ANON_KEY=
# Host pytest / CLI may use the superuser DSN. Compose API/worker must not.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# LOGIN wrapper (app_api is NOLOGIN). Run:
#   uv run python scripts/ops/ensure_app_runtime_role.py
APP_RUNTIME_DB_PASSWORD=change-me-app-runtime
# Optional Compose DSN overrides (must be non-superuser)
# API_SUPABASE_DB_URL=
# WORKER_SUPABASE_DB_URL=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Privileged Auth Admin boundary ONLY (never load into SharedSettings / frontend / worker)
# SUPABASE_AUTH_ADMIN_SECRET=

# Privileged Storage Admin boundary ONLY (list/delete quarantine; never SharedSettings)
# SUPABASE_STORAGE_ADMIN_SECRET=

# Managed Supabase (Smart RAG project � never commit secrets)
# SUPABASE_PROJECT_REF=qsjivtwtmlmtksufqjik
# SUPABASE_MANAGED_URL=https://qsjivtwtmlmtksufqjik.supabase.co
# SUPABASE_ACCESS_TOKEN=  # Management API � required for JWT signing-key rollover proof
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Compose frontend image build-args must set the three NEXT_PUBLIC_* keys;
# runtime env on a prebuilt Next.js bundle does not rewrite them.

# Phase 10 Packet 1 (reviewed IaC only). Live AWS/Supabase/Vercel/SES apply is
# Blocked until accounts and a valid session exist. Do not put secrets here.
# Staging Vercel may receive only the three NEXT_PUBLIC_* keys above.
# APP_ENV=staging belongs on EC2 Compose, not the developer workstation.
# Do not set SMART_RAG_HOLDOUT_ACCESS=true. MOCK_MODEL_MODE stays true locally.
