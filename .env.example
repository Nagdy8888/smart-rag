# Local development placeholders only. Copy to .env.compose (gitignored).
# No AWS required. Mock-model mode does not need a live OpenAI key.

APP_ENV=local
MOCK_MODEL_MODE=true
LOG_LEVEL=INFO
MOCK_MODEL_FIXTURE_ID=phase-1-foundation-v1
MODEL_INPUT_MAX_CHARS=16384
WORKER_ONCE=false

API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8000

# ParadeDB (private network only)
PARADEDB_DB=paradedb
PARADEDB_BOOTSTRAP_USER=paradedb
PARADEDB_BOOTSTRAP_PASSWORD=change-me-paradedb-bootstrap
PARADEDB_WRITER_USER=paradedb_writer
PARADEDB_WRITER_PASSWORD=change-me-paradedb-writer
PARADEDB_READER_USER=paradedb_reader
PARADEDB_READER_PASSWORD=change-me-paradedb-reader

# Valkey - distinct credentials and policies
VALKEY_LIMITS_PASSWORD=change-me-valkey-limits
VALKEY_CACHE_PASSWORD=change-me-valkey-cache

# Optional later (not required for mock foundation)
# OPENAI_API_KEY=replace-with-provider-key
# LANGSMITH_API_KEY=

# Local Supabase Auth / JWKS (FastAPI verifies asymmetric JWKS only — never JWT_SECRET)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_SECONDS=600
# SUPABASE_ANON_KEY=
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Privileged Auth Admin boundary ONLY (never load into SharedSettings / frontend / worker)
# SUPABASE_AUTH_ADMIN_SECRET=

# Privileged Storage Admin boundary ONLY (list/delete quarantine; never SharedSettings)
# SUPABASE_STORAGE_ADMIN_SECRET=

# Managed Supabase (Smart RAG project — never commit secrets)
# SUPABASE_PROJECT_REF=qsjivtwtmlmtksufqjik
# SUPABASE_MANAGED_URL=https://qsjivtwtmlmtksufqjik.supabase.co
# SUPABASE_ACCESS_TOKEN=  # Management API — required for JWT signing-key rollover proof
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
