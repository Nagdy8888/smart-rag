# Local development placeholders only. Copy to .env (gitignored).
# No AWS required. Mock-model mode does not need a live OpenAI key.

APP_ENV=local
MOCK_MODEL_MODE=true

API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ParadeDB (private network only)
PARADEDB_DB=paradedb
PARADEDB_BOOTSTRAP_USER=paradedb
PARADEDB_BOOTSTRAP_PASSWORD=change-me-paradedb-bootstrap
PARADEDB_WRITER_USER=paradedb_writer
PARADEDB_WRITER_PASSWORD=change-me-paradedb-writer
PARADEDB_READER_USER=paradedb_reader
PARADEDB_READER_PASSWORD=change-me-paradedb-reader

# Valkey — distinct credentials and policies
VALKEY_LIMITS_PASSWORD=change-me-valkey-limits
VALKEY_CACHE_PASSWORD=change-me-valkey-cache

# Optional later (not required for mock foundation)
# OPENAI_API_KEY=
# LANGSMITH_API_KEY=
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
